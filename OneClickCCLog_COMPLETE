<!DOCTYPE html>
<html lang="ko">

<head>
    <meta charset="UTF-8">
    <title>껍질 미리-깐 코코포 로그</title>
    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: Arial, sans-serif;
        }

        html, body {
            height: 100%;
            overflow: hidden;
            margin: 0;
        }

        .container {
            display: flex;
            height: 100vh;
        }

        .sidebar {
            width: 320px;
            padding: 20px 18px;
            background-color: #ffffff;
            border-right: 1px solid #e5e7eb;
            display: flex;
            flex-direction: column;
            gap: 16px;
            overflow-y: auto;
            flex-shrink: 0;
        }

        .sidebar h2 {
            margin: 0 0 4px;
            font-size: 16px;
            font-weight: 700;
            color: #111827;
        }

        .sidebar>p {
            margin: 0;
            font-size: 12px;
            line-height: 1.6;
            color: #6b7280;
        }

        .sidebar>p a {
            color: #2563eb;
            text-decoration: none;
            font-weight: 500;
        }

        .sidebar>p a:hover {
            text-decoration: underline;
        }

        .sidebar>hr {
            margin: 8px 0 4px;
            border: 0;
            border-top: 1px solid #e5e7eb;
        }

        .preview {
            flex: 1;
            height: 100%;
            overflow-y: auto;
            overflow-x: hidden;
            background-color: #1f1e22;
            color: white;
            padding: 10px;
            box-sizing: border-box;
        }

        button {
            padding: 9px 10px;
            font-size: 13px;
            cursor: pointer;
            border-radius: 8px;
            border: 1px solid #d1d5db;
            background-color: #ffffff;
            color: #111827;
            transition: background-color 0.15s, border-color 0.15s, box-shadow 0.15s;
        }

        button:hover {
            background-color: #f3f4f6;
            border-color: #2563eb;
            box-shadow: 0 0 0 1px rgba(37, 99, 235, 0.25);
        }

        .sidebar-tabs {
            display: flex;
            margin-top: 10px;
            border-radius: 999px;
            padding: 2px;
            background-color: #e5e7eb;
            gap: 2px;
        }

        .sidebar-tab {
            flex: 1;
            padding: 6px 0;
            font-size: 12px;
            background-color: transparent;
            border: none;
            cursor: pointer;
            text-align: center;
            border-radius: 999px;
            color: #6b7280;
        }

        .sidebar-tab.active {
            background-color: #2563eb;
            color: #f9fafb;
        }

        .tab-panel {
            margin-top: 10px;
            padding: 10px 10px 8px;
            border-radius: 10px;
            background-color: #f9fafb;
            border: 1px solid #e5e7eb;
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

        .tab-panel.hidden {
            display: none;
        }

        /* sidebar form controls */
        label {
            font-size: 12px;
            display: flex;
            flex-direction: column;
            gap: 4px;
            color: #374151;
        }

        .sidebar input[type="text"],
        .sidebar input[type="number"],
        .sidebar input[type="color"] {
            padding: 6px 10px;
            border-radius: 8px;
            border: 1px solid #d1d5db;
            font-size: 12px;
            box-sizing: border-box;
            background-color: #ffffff;
            color: #111827;
        }

        .sidebar input[type="color"] {
            height: 36px;
            cursor: pointer;
        }

        .sidebar input[type="text"]::placeholder,
        .sidebar input[type="number"]::placeholder {
            color: #9ca3af;
        }

        .sidebar input[type="text"]:focus,
        .sidebar input[type="number"]:focus {
            outline: none;
            border-color: #2563eb;
            box-shadow: 0 0 0 1px rgba(37, 99, 235, 0.35);
        }

        input[type="number"] {
            width: 60px;
            padding: 5px;
        }

        /* tab-narrator modern layout */
        #tab-narrator {
            flex-direction: column;
            gap: 8px;
        }

        #tab-narrator label {
            display: flex;
            flex-direction: column;
            gap: 4px;
        }

        #tab-narrator label:last-child {
            flex-direction: row;
            align-items: center;
            gap: 6px;
            margin-top: 4px;
        }

        #tab-narrator input[type="text"] {
            width: 100%;
            box-sizing: border-box;
        }

        #tab-narrator input[type="checkbox"] {
            width: auto;
        }

        /* tab-style 동일 스타일 */
        #tab-style label:last-child {
            flex-direction: row;
            align-items: center;
            gap: 6px;
            margin-top: 4px;
        }

        #tab-style input[type="checkbox"] {
            width: auto;
        }

        p {
            margin: 0;
        }

        b {
            color: gray;
            font-size: 9pt;
            font-weight: 200;
        }

        span,
        b {
            font-size: 16px;
            font-family: 'Arial', sans-serif;
            line-height: 1.5;
        }

        .preview p,
        .preview span,
        .preview b {
            white-space: pre-wrap;
        }

        /* 기본 다크 배경 / 글꼴 색 (채널 색상 적용 전 초기 상태) */
        .preview .ccfolia_wrap {
            background-color: #1f1e22;
            color: #ddd;
        }

        b {
            font-weight: bold;
        }

        .ccfolia_wrap {
            position: relative;
            background-color: #2c2c2cde;
            color: #fefefe;
        }

        .msg_container {
            flex-shrink: 0;
            width: 40px;
            height: 40px;
            overflow: hidden;
            background: rgba(0, 0, 0, 0.2);
            border-radius: 5px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .msg_container img {
            width: 40px;
        }

        span:before {
            display: none !important;
        }


        .gap {
            gap: 15px;
            display: flex;
            -webkit-box-pack: start;
            justify-content: flex-start;
            align-items: flex-start;
            position: relative;
            text-decoration: none;
            width: 100%;
            box-sizing: border-box;
            text-align: left;
            padding: 16px 16px;
            border-top: 1px solid rgba(255, 255, 255, 0.08);
        }

        hr {
            display: none;
        }

        /* 전역 삭제 버튼 */
        #globalDeleteBtn {
            position: fixed;
            background: rgba(255, 50, 50, 0.8);
            border: none;
            color: white;
            font-weight: bold;
            padding: 2px 6px;
            border-radius: 50%;
            cursor: pointer;
            display: none;
            z-index: 9999;
            pointer-events: auto;
            width: 24px;
            height: 24px;
            font-size: 14px;
            line-height: 1;
        }

        .preview .gap:hover,
        .preview .player.system:hover {
            outline: 1px solid rgba(255, 50, 50, 0.3);
        }

        /* 비밀 메시지 뱃지 */
        .secret-badge {
            display: inline-block;
            background-color: #ffffff2b;
            color: white;
            font-size: 10px;
            padding: 2px 6px;
            border-radius: 4px;
            font-weight: normal;
            position: absolute;
            right: 16px;
            top: 8px;
            z-index: 10;
        }

        /* Light theme overrides */
        .preview.light {
            background-color: #f1f1f1;
            color: #000000;
        }

        .preview.light .ccfolia_wrap {
            background-color: #f9fafb !important;
        }

        .preview.light .gap {
            border-top-color: rgba(0, 0, 0, 0.1);
        }

        .preview.light p,
        .preview.light span {
            color: #575757 !important;
        }

        .preview.light .msg_container {
            background: transparent !important;
        }

        .preview.light .player.system {
            background: rgb(0 0 0 / 4%) !important;
            border-top-color: rgba(0, 0, 0, 0.1) !important;
        }

        .preview.light .player.system .Uname {
            background: #0000001c !important;
            color: #5a6671 !important;
        }

        .preview.light .player.system .Utext {
            color: #4b5563 !important;
        }
        .preview .player.system { text-align: center; justify-content: center; }
        .preview .player.system { width: 100%; max-width: none; margin: 0; border-radius: 0; background: transparent !important; }
        .preview .player.system .textWrap { float: none !important; width: auto; max-width: calc(100% - 32px); box-sizing: border-box; margin: 0 auto !important; text-align: center; overflow-wrap: anywhere; }
        .preview .player.system .Uname { display: table; width: auto; margin-left: auto !important; margin-right: auto !important; }
        .preview .player.system .Utext { text-align: center; }

        .preview.light .secret-badge {
            background-color: #0000002b;
            color: #111827;
        }

        .portrait-options {
            display: flex;
            flex-wrap: wrap;
            gap: 6px;
        }
        .portrait-option {
            width: 52px;
            height: 52px;
            padding: 2px;
            border: 2px solid #d1d5db;
            border-radius: 7px;
            background: #f3f4f6;
            cursor: pointer;
        }
        .portrait-option.active { border-color: #2563eb; box-shadow: 0 0 0 1px #2563eb; }
        .portrait-option img { width: 100%; height: 100%; object-fit: cover; border-radius: 4px; }
        .portrait-option img { object-position: top center; }
        .tab-setting-btn { width: 100%; text-align: left; display: flex; align-items: center; justify-content: space-between; }
        .tab-setting-btn.active { border-color: #2563eb; background: #eff6ff; }
        .tab-setting-meta { color: #6b7280; font-size: 11px; }
        .modal-overlay { position: fixed; inset: 0; background: rgba(0,0,0,.5); display: flex; align-items: center; justify-content: center; z-index: 10000; }
        .modal-overlay.hidden { display: none; }
        .modal-panel { background: #fff; color: #111827; border-radius: 12px; padding: 18px; width: min(560px, calc(100vw - 32px)); max-height: 85vh; display: flex; flex-direction: column; gap: 12px; box-shadow: 0 10px 30px rgba(0,0,0,.3); }
        .modal-header { display: flex; justify-content: space-between; align-items: center; }
        .modal-header h3 { margin: 0; font-size: 16px; }
        .modal-close { border: 0; background: transparent; font-size: 18px; padding: 4px; }
        .modal-list { overflow-y: auto; display: flex; flex-direction: column; gap: 8px; }
        .modal-tab-row { display: grid; grid-template-columns: auto 1fr repeat(3, auto); gap: 8px; align-items: center; border: 1px solid #e5e7eb; border-radius: 8px; padding: 8px; font-size: 12px; }
        .modal-tab-row label { flex-direction: row; align-items: center; gap: 4px; white-space: nowrap; }
        .output-switch { position: relative; width: 38px; height: 22px; flex-shrink: 0; display: block; cursor: pointer; }
        .output-switch input { position: absolute; inset: 0; z-index: 2; opacity: 0; width: 100%; height: 100%; margin: 0; cursor: pointer; }
        .output-slider { position: absolute; inset: 0; border-radius: 999px; background: #c7cbd1; cursor: pointer; transition: .2s; }
        .output-slider:before { content: ''; display: block !important; position: absolute; z-index: 1; width: 18px; height: 18px; left: 2px; top: 2px; border-radius: 50%; background: #fff !important; transition: .2s; box-shadow: 0 1px 3px #0004; }
        .output-switch input:checked + .output-slider { background: #2563eb; }
        .output-switch input:checked + .output-slider:before { transform: translateX(16px); }
        .tab-setting-btn.tab-disabled { color: #9ca3af; background: #f3f4f6; border-color: #d1d5db; }
        .tab-option-disabled { opacity: .4; }
        .tab-toggle { padding: 5px 8px; border-radius: 999px; font-size: 11px; white-space: nowrap; border: 1px solid #d1d5db; background: #fff; color: #6b7280; cursor: pointer; }
        .tab-toggle.active { color: #fff; background: #2563eb; border-color: #2563eb; }
        .tab-toggle:disabled { opacity: .35; cursor: not-allowed; }
        #progressOverlay { display:none; position:fixed; inset:0; z-index:20000; background:rgba(0,0,0,.28); align-items:flex-start; justify-content:center; pointer-events:none; }
        #progressOverlay.show { display:flex; }
        .progress-box { margin-top:18px; width:min(420px,calc(100vw - 32px)); padding:12px 14px; border-radius:10px; background:#fff; color:#111827; box-shadow:0 5px 20px #0004; font-size:12px; }
        .progress-track { height:6px; margin-top:8px; overflow:hidden; border-radius:99px; background:#e5e7eb; }
        .progress-fill { width:35%; height:100%; border-radius:99px; background:#2563eb; animation:progress-slide 1s ease-in-out infinite; }
        @keyframes progress-slide { 0%{transform:translateX(-120%)} 100%{transform:translateX(320%)} }
        .modal-detail { border-top: 1px solid #e5e7eb; padding-top: 10px; overflow-y: auto; }
        .image-modal-panel { width: min(760px, calc(100vw - 32px)); }
        .image-modal-list { overflow-y: auto; display: flex; flex-direction: column; gap: 16px; }
        .image-journal-block { border: 1px solid #e5e7eb; border-radius: 10px; padding: 12px; }
        .image-journal-title { font-weight: 700; font-size: 13px; margin-bottom: 8px; }
        .image-choice-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(82px, 1fr)); gap: 10px; }
        .image-choice { aspect-ratio: 1; min-width: 0; padding: 3px; border: 2px solid #d1d5db; border-radius: 9px; background: #f3f4f6; cursor: pointer; }
        .image-choice.active { border-color: #2563eb; box-shadow: 0 0 0 2px #93c5fd; }
        .image-choice img { display: block; width: 100%; height: 100%; object-fit: cover; object-position: top center; border-radius: 6px; }
        .image-fallback { color: #6b7280; font-size: 12px; margin-top: 8px; }
        .gap.other-compact { display: block !important; padding: 4px 16px !important; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
        .gap.other-compact .compact-name { font-weight: 700; margin-right: 6px; }
        .gap.other-compact .compact-text { color: #ddd; }
        .preview.light .gap.other-compact .compact-text { color: #575757; }
        .preview .gap.info-message.bubble-themed,
        .preview .gap.other-message.bubble-themed {
            width: 100%;
            margin: 0;
            border: 0;
            border-radius: 0;
            box-shadow: none;
        }
        .preview .gap.info-message.bubble-themed {
            padding: 4px 16px !important;
        }
        .preview .gap.other-message.bubble-themed {
            margin-top: 0;
            margin-bottom: 0;
            border: 0;
            border-radius: 20px;
            padding: 2px 16px !important;
            background-color: var(--main-card-color) !important;
        }
        .preview .gap.info-message.bubble-themed .bubble-surface,
        .preview .gap.other-message.bubble-themed .bubble-surface {
            display: flex;
            align-items: flex-start;
            gap: 15px;
            width: 100%;
            box-sizing: border-box;
            position: relative;
            padding: 8px 12px;
            border-radius: 16px;
            background-color: var(--bubble-color) !important;
        }
        .preview .gap.info-message.bubble-themed .bubble-surface { border-radius: 12px; }
        .preview .gap.info-message.bubble-themed .bubble-surface {
            border: 1px solid rgba(255,255,255,.12);
            border-left: 4px solid rgba(255,255,255,.45);
            box-shadow: 0 3px 10px rgba(0,0,0,.12);
        }
        .preview .gap.other-message.bubble-themed.other-compact .bubble-surface {
            display: block;
            padding: 7px 12px;
            border-radius: 16px;
        }
        .preview .gap.other-message.other-compact {
            padding: 7px 12px !important;
            border-radius: 0;
        }
        .preview.light .gap.info-message.bubble-themed,
        .preview.light .gap.other-message.bubble-themed { border-color: transparent; box-shadow: none; }
        .preview.light .gap.info-message.bubble-themed .bubble-surface {
            border-color: rgba(0,0,0,.1);
            border-left-color: rgba(0,0,0,.22);
            box-shadow: 0 3px 10px rgba(0,0,0,.06);
        }
        .journal-row { display: flex; align-items: center; gap: 8px; padding: 7px 0; border-bottom: 1px solid #f0f0f0; font-size: 12px; }
        .journal-name { width: 100px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
        .link-input { flex: 1; min-width: 0; padding: 6px 8px; border: 1px solid #d1d5db; border-radius: 6px; }
        body.light .modal-panel { background: #fff; }
    </style>
</head>

<body>
    <div id="progressOverlay"><div class="progress-box"><span id="progressText">로그를 불러오는 중...</span><div class="progress-track"><div class="progress-fill"></div></div></div></div>
    <div class="container">
        <div class="sidebar">
            <h2>껍질 미리-깐 코코포 로그 (완전판!)</h2>
            <hr />
            <label>
                이전 로그 플러그인 HTML:
                <input type="file" id="pluginHtmlInput" accept=".html,.htm" />
            </label>
            <label>
                코코포리아 전체 내보내기 HTML:
                <input type="file" id="htmlFileInput" accept=".html,.htm" />
            </label>
            <label>
                저장 파일명(선택):
                <input type="text" id="roomInput" placeholder="ccfolia-wrap" />
            </label>
            <button type="button" id="outputTabSettingsBtn">출력 탭 설정</button>

            <div class="sidebar-tabs">
                <button type="button" class="sidebar-tab active" data-target="tab-narrator">서술자 설정</button>
                <button type="button" class="sidebar-tab" data-target="tab-style">스타일 설정</button>
            </div>

            <div id="tab-narrator" class="tab-panel">
                <label>
                    서술자 이름:
                    <input type="text" id="narratorInput" placeholder="이름 정확히 입력" />
                </label>
                <label style="flex-direction: row; align-items: center; gap: 6px;">
                    <input type="checkbox" id="removeNarratorItalicCheckbox" style="width:auto;" /> 서술자 기울임 제거
                </label>
            </div>

            <div id="tab-style" class="tab-panel hidden">
                <label style="flex-direction: row; align-items: center; gap: 6px;">
                    패딩 (상하 px):
                    <input type="number" id="paddingInput" value="16" min="0" />
                    폰트 크기 (px):
                    <input type="number" id="fontSizeInput" value="16" min="8" max="32" />
                </label>
                <div id="channelColorSettings">
                    <!-- 동적으로 채널별 색상 설정이 추가됩니다 -->
                </div>
                <label style="flex-direction: row; align-items: center; gap: 6px;">
                    <input type="checkbox" id="lightThemeToggle" /> 라이트 테마
                </label>
                <label style="flex-direction: row; align-items: center; gap: 6px;">
                    <input type="checkbox" id="bubbleThemeToggle" checked /> info/other 말풍선 테마
                </label>
            </div>

            <div style="margin-top: 10px; display: flex; flex-direction: column; gap: 6px;">
                <button id="applyStyleBtn">스타일 적용</button>
                <button id="saveHTMLBtn">HTML 저장</button>
                <button id="saveTxtBtn">TXT 저장</button>
            </div>

        </div>

        <div class="preview" id="previewArea"></div>
    </div>

    <button id="globalDeleteBtn">✕</button>

    <div id="outputTabModal" class="modal-overlay hidden">
        <div class="modal-panel">
            <div class="modal-header"><h3>출력 탭 설정</h3><button type="button" class="modal-close" id="outputTabModalClose">✕</button></div>
            <div id="outputTabList" class="modal-list"></div>
            <div id="outputTabDetail" class="modal-detail"><span style="color:#6b7280;font-size:12px;">탭을 선택하면 저널별 이미지 설정이 표시됩니다.</span></div>
        </div>
    </div>
    <div id="journalImageModal" class="modal-overlay hidden">
        <div class="modal-panel image-modal-panel">
            <div class="modal-header"><h3>저널별 이미지 설정</h3><button type="button" class="modal-close" id="journalImageModalClose">✕</button></div>
            <p id="journalImageModalNote" style="margin:0;color:#6b7280;font-size:12px;"></p>
            <div id="journalImageList" class="image-modal-list"></div>
        </div>
    </div>

    <script>
        const previewArea = document.getElementById('previewArea');
        const styleButton = document.getElementById('applyStyleBtn');
        const paddingInput = document.getElementById('paddingInput');
        const fontSizeInput = document.getElementById('fontSizeInput');

        // 사이드바 탭 전환
        const sidebarTabs = document.querySelectorAll('.sidebar-tab');
        const tabPanels = document.querySelectorAll('.tab-panel');

        sidebarTabs.forEach(tab => {
            tab.addEventListener('click', () => {
                const targetId = tab.getAttribute('data-target');

                sidebarTabs.forEach(t => t.classList.remove('active'));
                tabPanels.forEach(panel => {
                    if (panel.id === targetId) {
                        panel.classList.remove('hidden');
                    } else {
                        panel.classList.add('hidden');
                    }
                });

                tab.classList.add('active');
            });
        });

        // 전역 삭제 버튼 로직
        const globalDeleteBtn = document.getElementById('globalDeleteBtn');
        let currentHoverGap = null;

        // 이벤트 위임 방식으로 변경
        document.addEventListener('mouseover', (e) => {
            const hovered = e.target.closest('.gap') || e.target.closest('.player.system');
            if (hovered && previewArea.contains(hovered)) {
                currentHoverGap = hovered;
                const rect = hovered.getBoundingClientRect();
                globalDeleteBtn.style.left = (rect.right - 30) + 'px';
                globalDeleteBtn.style.top = (rect.top + 5) + 'px';
                globalDeleteBtn.style.display = 'block';
            } else if (!e.target.closest('#globalDeleteBtn')) {
                // 버튼 위가 아니고 대상 위도 아니면 숨김
                if (currentHoverGap && !currentHoverGap.contains(e.target)) {
                    globalDeleteBtn.style.display = 'none';
                    currentHoverGap = null;
                }
            }
        });

        globalDeleteBtn.addEventListener('click', (e) => {
            e.preventDefault();
            e.stopPropagation();
            if (currentHoverGap) {
                currentHoverGap.remove();
                globalDeleteBtn.style.display = 'none';
                currentHoverGap = null;
            }
        });

        // 버튼 위에 마우스가 있을 때 버튼 유지
        globalDeleteBtn.addEventListener('mouseenter', () => {
            if (currentHoverGap) {
                globalDeleteBtn.style.display = 'block';
            }
        });

        // 라이트 테마 토글
        const lightThemeToggle = document.getElementById('lightThemeToggle');
        const bubbleThemeToggle = document.getElementById('bubbleThemeToggle');
        let bubbleThemeEnabled = true;
