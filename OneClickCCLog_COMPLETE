                    const spanText = document.createElement('span');
                    spanText.innerHTML = m.text.replace(/[&<>"]/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c])).replace(/\n/g, '<br>');
                    spanText.style.fontSize = `${fontSizeValue}px`;
                    p.appendChild(spanText);
                    gap.appendChild(p);
                } else {
                    // 일반 메시지 스타일
                    gap.style.cssText = `display: flex; background-color: ${cardBackgroundColor}; position: relative; padding: ${paddingValue}px 16px;`;
                    if (plainChannel) {
                        gap.style.setProperty('--main-card-color', cardBackgroundColor);
