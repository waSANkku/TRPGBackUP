                const cardBackgroundColor = plainChannel && bubbleThemeEnabled ? getMainChannelColor() : channelBackgroundColor;
                const bubbleColor = plainChannel && bubbleThemeEnabled ? channelBackgroundColor : cardBackgroundColor;
                if (plainChannel) {
                    gap.style.setProperty('--main-card-color', cardBackgroundColor);
