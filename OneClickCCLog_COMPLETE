                if (isNarrator) {
                    // 서술자 스타일
                    const fontStyleValue = removeItalic ? 'normal' : 'italic';
                    gap.style.cssText = `display: flow-root; background-color: ${channelBackgroundColor}; position: relative; padding: 2px 16px; text-align: center;`;

                    const p = document.createElement('p');
