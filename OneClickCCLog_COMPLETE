                else if (isOther) gap.classList.add('other-message');
                const isCompactOther = isOther && tabSettings.get(m.channel)?.compact;
                const isNarrator = !!narratorName && m.name === narratorName && /main|메인/i.test(m.channel);
                const useBubbleSurface = plainChannel && bubbleThemeEnabled;
                const bubbleSurface = useBubbleSurface ? document.createElement('div') : gap;
                if (useBubbleSurface) bubbleSurface.className = 'bubble-surface';

                if (isCompactOther) {
                    gap.classList.add('other-compact');
                    const name = document.createElement('span'); name.className = 'compact-name'; name.textContent = m.name; name.style.setProperty('color', m.color || '#ccc', 'important');
                    const text = document.createElement('span'); text.className = 'compact-text'; text.textContent = `: ${m.text}`;
                    bubbleSurface.append(name, text);
