                    const p = document.createElement('p');
                    p.style.color = 'rgb(221, 221, 221)';

                    const spanEmpty = document.createElement('span');
                    const spanName = document.createElement('span');
                    spanName.textContent = m.name;
                    // 라이트 테마의 .light span { color !important } 보다 우선하도록 인라인 !important
                    spanName.style.setProperty('color', m.color, 'important');
                    spanName.style.fontWeight = 'bold';
                    spanName.style.fontSize = `${fontSizeValue}px`;

                    const spanBr = document.createElement('span');
                    spanBr.innerHTML = '<br>';

                    const spanText = document.createElement('span');
                    spanText.innerHTML = m.text.replace(/[&<>"]/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c])).replace(/\n/g, '<br>');
                    spanText.style.fontSize = `${fontSizeValue}px`;

                    p.appendChild(spanEmpty);
                    p.appendChild(spanName);
                    p.appendChild(spanBr);
                    p.appendChild(spanText);
                    bubbleSurface.appendChild(p);

                    // 비밀 채널 메시지에 (비밀) 뱃지 추가
                    // 더 유연한 채널명 매칭 (공백 제거, 대소문자 무시)
                    const normalizedChannel = m.channel.replace(/\s+/g, '').toLowerCase();
                    if (normalizedChannel === '비밀' || normalizedChannel === 'secret' || m.channel.includes('비밀')) {
                        const secretBadge = document.createElement('span');
                        secretBadge.className = 'secret-badge';
                        secretBadge.textContent = '귓속말';
                        secretBadge.style.fontSize = `${parseInt(fontSizeValue)-3}px`;
                        bubbleSurface.appendChild(secretBadge);
                    }
                    // 채널 뱃지는 출력 탭 설정 팝업에서만 관리
                    if (tabSettings.get(m.channel)?.badge) {
                        const channelBadge = document.createElement('span');
                        channelBadge.className = 'secret-badge';
                        channelBadge.textContent = m.channel;
