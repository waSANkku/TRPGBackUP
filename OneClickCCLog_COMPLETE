        // 채널별 색상 설정 생성
        function createChannelColorSettings() {
            const channelSet = new Set(window.allMessages.map(m => m.channel));
            const container = document.getElementById('channelColorSettings');
            container.innerHTML = '';
            channelColors = {};

            // 기본 색상 설정
            const defaultColors = {
                '메인': '#1f1e22',
                '비밀': '#3d3d3d',
                '사담': '#3d3d3d',
                '기타': '#3d3d3d',
                'info': '#3d3d3d',
                '정보': '#3d3d3d'
            };

            channelSet.forEach(channel => {
                // 채널명에 특정 키워드가 포함된 경우 해당 색상 적용
                let colorKey = '기타'; // 기본값
                if (channel.includes('메인') || channel.includes('main')) {
                    colorKey = '메인';
                } else if (channel.includes('비밀')) {
                    colorKey = '비밀';
                    // 비밀은 귓속말 뱃지 자동 표시, 체크박스 불필요
                } else if (channel.includes('사담') || channel.includes('other')) {
                    colorKey = '사담';
                } else if (channel.includes('info') || channel.includes('정보')) {
                    colorKey = 'info';
                }

                const label = document.createElement('label');
                label.style.cssText = 'flex-direction: row; align-items: center; gap: 6px;';
                label.dataset.channel = channel;

                const baseColor = lightThemeToggle.checked
                    ? ((channel.includes('메인') || channel.includes('main')) ? '#f1f1f1' : '#E3E3E3')
                    : (defaultColors[colorKey] || '#3d3d3d');
                const isBubbleChannel = /info|정보|other/i.test(channel);
                const bubbleBaseColor = lightThemeToggle.checked ? '#f1f1f1' : '#1f1e22';
                const defaultColor = isBubbleChannel && bubbleThemeEnabled
                    ? mixHex(bubbleBaseColor, lightThemeToggle.checked ? '#000000' : '#ffffff', 0.07)
                    : baseColor;

                label.innerHTML = `
                    ${channel}:
                    <input type="color" id="channelColor_${channel}" value="${defaultColor}" />
                `;
                label.querySelector('input[type="color"]').dataset.channel = channel;
                container.appendChild(label);
            });

            // 저장된 채널 설정 복원 후, 변경 시 자동 저장 리스너 등록
            restoreChannelSettings();
            if (lightThemeToggle.checked) {
                channelSet.forEach(channel => {
                    const colorInput = [...container.querySelectorAll('input[type="color"]')].find(x => x.dataset.channel === channel);
                    if (!colorInput) return;
                    colorInput.value = /info|정보|other/i.test(channel)
                        ? mixHex('#f1f1f1', '#000000', 0.07)
                        : (/main|메인/i.test(channel) ? '#f1f1f1' : '#E3E3E3');
                });
            }
            channelSet.forEach(channel => {
                const colorInput = [...container.querySelectorAll('input[type="color"]')].find(x => x.dataset.channel === channel);
                if (colorInput) {
                    channelColors[channel] = colorInput.value;
                    colorInput.addEventListener('input', () => {
                        channelColors[channel] = colorInput.value;
                        if (/info|정보|other/i.test(channel)) bubbleCustomColors.add(channel);
                        else if (/main|메인/i.test(channel) && bubbleThemeEnabled) applyBubbleDefaultColors();
                        renderMessages();
                    });
                }
                document.getElementById(`channelColor_${channel}`)?.addEventListener('change', saveChannelSettings);
            });
            syncStyleChannelVisibility();
        }

        // Firestore 메시지 불러오기 시 주소에서 ID 추출
        function extractRoomId(input) {
            const match = input.match(/rooms\/([\w-]+)/);
            return match ? match[1] : input.trim();
        }

        // ─── 설정 저장/불러오기 (localStorage) ───────────────────────────
        const SETTINGS_KEY = 'ccfolia_settings';
        const CHANNEL_SETTINGS_KEY = 'ccfolia_channel_settings';

        function saveSettings() {
            const s = {
                narratorName: document.getElementById('narratorInput')?.value ?? '',
                removeItalic: document.getElementById('removeNarratorItalicCheckbox')?.checked ?? false,
                padding: document.getElementById('paddingInput')?.value ?? '16',
                fontSize: document.getElementById('fontSizeInput')?.value ?? '16',
                lightTheme: document.getElementById('lightThemeToggle')?.checked ?? false,
                bubbleTheme: document.getElementById('bubbleThemeToggle')?.checked ?? true,
            };
            localStorage.setItem(SETTINGS_KEY, JSON.stringify(s));
        }

        function loadSettings() {
            const raw = localStorage.getItem(SETTINGS_KEY);
            if (!raw) return;
            try {
                const s = JSON.parse(raw);
                if (s.narratorName != null) document.getElementById('narratorInput').value = s.narratorName;
                document.getElementById('removeNarratorItalicCheckbox').checked = s.removeItalic ?? false;
                if (s.padding != null) document.getElementById('paddingInput').value = s.padding;
                if (s.fontSize != null) document.getElementById('fontSizeInput').value = s.fontSize;
                const lightToggle = document.getElementById('lightThemeToggle');
                lightToggle.checked = s.lightTheme ?? false;
                bubbleThemeToggle.checked = s.bubbleTheme ?? true;
                bubbleThemeEnabled = bubbleThemeToggle.checked;
                if (lightToggle.checked) previewArea.classList.add('light');
            } catch (e) {
                console.warn('설정 불러오기 실패:', e);
            }
        }

        function saveChannelSettings() {
            const channelSet = new Set(window.allMessages.map(m => m.channel));
            const s = {};
            channelSet.forEach(channel => {
                s[channel] = {
                    color: document.getElementById(`channelColor_${channel}`)?.value,
                };
            });
            localStorage.setItem(CHANNEL_SETTINGS_KEY, JSON.stringify(s));
        }

        function restoreChannelSettings() {
            const raw = localStorage.getItem(CHANNEL_SETTINGS_KEY);
            if (!raw) return;
            try {
                const s = JSON.parse(raw);
                Object.entries(s).forEach(([channel, cs]) => {
                    const colorEl = document.getElementById(`channelColor_${channel}`);
                    if (colorEl && cs.color) colorEl.value = cs.color;
                });
            } catch (e) {
                console.warn('채널 설정 불러오기 실패:', e);
            }
        }

        // 정적 입력 자동 저장
        ['narratorInput', 'paddingInput', 'fontSizeInput'].forEach(id => {
            document.getElementById(id)?.addEventListener('input', saveSettings);
        });
        ['removeNarratorItalicCheckbox', 'lightThemeToggle'].forEach(id => {
            document.getElementById(id)?.addEventListener('change', saveSettings);
        });

        loadSettings();

        // ─── HTML 업로드 → 파싱 (확장 뷰어 출력 형식) ───────────────
        // 편집 완료 표식 제거
        const stripEdited = (s) => (s || '').replace(/(\s*\[편집\s*완료\])+\s*$/, '').trim();

        function parseViewerHTML(htmlString) {
            const doc = new DOMParser().parseFromString(htmlString, 'text/html');
            // 신규 경량 구조(.m) 우선, 없으면 레거시(.MUI [data-index]) 폴백
            const compact = doc.querySelectorAll('.m');
            const msgs = [];

            if (compact.length) {
                compact.forEach(x => {
                    const nm = x.querySelector('.nm');
                    let name = '', color = '';
                    if (nm) {
                        for (const n of nm.childNodes) if (n.nodeType === 3) name += n.textContent;
                        name = name.trim();
                        color = nm.style.color || '';
                    }
                    const tx = x.querySelector('.tx');
                    let text = '';
                    if (tx) {
                        const clone = tx.cloneNode(true);
                        clone.querySelectorAll('br').forEach(br => br.replaceWith('\n'));
                        text = stripEdited(clone.textContent);
                    }
                    const img = x.querySelector('img.av') || x.querySelector('img');
                    const icon = img ? (img.getAttribute('src') || '') : '';
                    if (x.classList.contains('sys') || name.toLowerCase() === 'system') {
                        msgs.push({ name: 'system', text, icon: '', color: '#ccc', channel: '메인' });
                        return;
                    }
                    if (!name) name = icon ? '이름 없음' : 'system';
                    if (text === '') return;
                    msgs.push({ name, text, icon, color: color || '#ccc', channel: '메인' });
                });
                return msgs;
            }

            // 레거시 구조
            const items = doc.querySelectorAll('[data-index]');
            items.forEach(x => {
                const h6 = x.querySelector('h6');
                let name = '', color = '';
                if (h6) {
                    for (const n of h6.childNodes) if (n.nodeType === 3) name += n.textContent;
                    name = name.trim();
                    color = h6.style.color || '';
                }
                const p = x.querySelector('p');
                const text = stripEdited(p ? p.textContent : '');
                const img = x.querySelector('.MuiListItemAvatar-root img') || x.querySelector('img');
                const icon = img ? (img.getAttribute('src') || '') : '';
                if (!name) name = icon ? '이름 없음' : 'system';
                if (text === '' && name.toLowerCase() !== 'system') return;
                msgs.push({ name, text, icon, color: color || '#ccc', channel: '메인' });
            });
            return msgs;
        }

        function loadFromHTMLFile(file) {
            const reader = new FileReader();
            reader.onload = (e) => {
                try {
                    const msgs = parseViewerHTML(e.target.result);
                    if (!msgs.length) {
                        previewArea.innerHTML = '<p style="color:red;padding:20px;">메시지를 찾지 못했습니다. (확장 뷰어 형식의 HTML인지 확인하세요)</p>';
                        return;
                    }
                    window.allMessages = msgs;
                    window.selectedChannels = new Set(); // 단일 채널 → 전체 표시
                    renderChannelFilter();
                    createChannelColorSettings();
                    renderMessages(); // renderMessages가 시스템/서술자/패딩/배경/편집까지 전부 처리
                } catch (err) {
                    console.error(err);
                    previewArea.innerHTML = `<p style="color:red;padding:20px;">파싱 오류: ${err.message}</p>`;
                }
            };
            reader.onerror = () => { previewArea.innerHTML = '<p style="color:red;padding:20px;">파일 읽기 실패</p>'; };
            reader.readAsText(file, 'UTF-8');
        }

        // 독립 실행형 입력: 이전 로그 HTML은 포트레이트 원본으로만 사용하고,
        // 실제 메시지/탭은 코코포리아 전체 내보내기 HTML에서 읽는다.
        const pluginHtmlInput = document.getElementById('pluginHtmlInput');
        const exportHtmlInput = document.getElementById('htmlFileInput');
        let pluginPortraits = new Map();
        let pluginJournalColors = new Map();
        let pluginMainMessages = [];
        let whisperPortraits = {};
        let channelColors = {};

        const readLocalHTML = file => new Promise((resolve, reject) => {
            const reader = new FileReader();
            reader.onload = e => resolve(e.target.result);
            reader.onerror = () => reject(new Error('파일 읽기 실패'));
            reader.readAsText(file, 'UTF-8');
        });

        function getPluginPortraits(html) {
            const map = new Map();
            pluginMainMessages = parseViewerHTML(html);
            pluginMainMessages.forEach(m => {
                if (!m.name || m.name.toLowerCase() === 'system') return;
                if (m.color && !pluginJournalColors.has(m.name)) pluginJournalColors.set(m.name, m.color);
                if (!m.icon) return;
                if (!map.has(m.name)) map.set(m.name, []);
                if (!map.get(m.name).includes(m.icon)) map.get(m.name).push(m.icon);
            });
            return map;
        }

        function getChannelColor(channel) {
            return channelColors[channel] || '#1f1e22';
        }

        function mixHex(hex, overlay, ratio) {
            const values = [hex, overlay].map(value => value.match(/[\da-f]{2}/gi)?.map(part => parseInt(part, 16)) || [0, 0, 0]);
            return '#' + values[0].map((value, i) => Math.round(value * (1 - ratio) + values[1][i] * ratio).toString(16).padStart(2, '0')).join('');
        }

        function getMainChannelColor() {
            const main = [...Object.keys(channelColors)].find(channel => /main|메인/i.test(channel));
            return main ? getChannelColor(main) : '#1f1e22';
        }

        function sourceChannel(node) {
            const explicit = node.getAttribute('data-channel') || node.getAttribute('data-tab') || node.getAttribute('data-room-tab');
            if (explicit) return explicit;
            const owner = node.closest('[data-channel-name],[data-tab-name],.channel,.tab,.log-channel');
            if (owner) return owner.getAttribute('data-channel-name') || owner.getAttribute('data-tab-name') || owner.dataset.channel || owner.dataset.tab || owner.textContent.trim();
            let heading = node.previousElementSibling;
            while (heading) {
                if (/^H[1-6]$/.test(heading.tagName)) return heading.textContent.trim();
                heading = heading.previousElementSibling;
            }
            return '메인';
        }

        function parseWholeExport(html) {
            const doc = new DOMParser().parseFromString(html, 'text/html');
            // 코코포리아 전체 내보내기 형식:
            // <p style="color:..."><span>[탭]</span><span>이름</span><span>내용<br>...</span></p>
            const exportedRows = [...doc.querySelectorAll('p')].map(p => {
                const spans = [...p.children].filter(x => x.tagName === 'SPAN');
                if (spans.length < 3) return null;
                const textOf = node => { const copy = node.cloneNode(true); copy.querySelectorAll('br').forEach(br => br.replaceWith('\n')); return copy.textContent.trim(); };
                const channel = textOf(spans[0]).replace(/^\[|\]$/g, '').trim() || '메인';
                const name = textOf(spans[1]) || 'system';
                const text = stripEdited(textOf(spans[2]));
                if (!text && name.toLowerCase() !== 'system') return null;
                return { name, text, icon: '', color: p.style.color || '#ccc', channel };
            }).filter(Boolean);
            if (exportedRows.length) return exportedRows;

            const nodes = [...doc.querySelectorAll('.m,[data-index],.gap,article,li,tr')]
                .filter(n => !n.parentElement?.closest('.m,[data-index],.gap,article,li,tr'));
            const messages = [];
            nodes.forEach(x => {
                const compact = x.matches('.m') || x.querySelector('.nm,.tx');
                const nameNode = x.querySelector('.nm,[class*="name"],[class*="user"],h6');
                const textNode = x.querySelector('.tx,[class*="message"],[class*="text"]') || x.querySelector('p');
                let name = nameNode ? nameNode.textContent.trim() : '';
                let text = textNode ? textNode.textContent.trim() : x.textContent.trim();
                if (!compact && !name && !text) return;
                const dt = nameNode?.querySelector('.dt');
                if (dt) { name = name.replace(dt.textContent, '').trim(); }
                if (!name) name = 'system';
                text = stripEdited(text);
                if (!text && name.toLowerCase() !== 'system') return;
                const icon = x.querySelector('img')?.getAttribute('src') || '';
                const channel = sourceChannel(x);
                messages.push({ name, text, icon, color: nameNode?.style.color || '#ccc', channel });
            });
            return messages;
        }

        function applyImportedPortraits() {
            const mainUseCount = new Map();
            window.allMessages.forEach(m => {
                const setting = tabSettings.get(m.channel);
                const journalKey = `${m.channel}|${m.name}`;
                if (pluginJournalColors.has(m.name)) m.color = pluginJournalColors.get(m.name);
                if (/main|메인/i.test(m.channel)) {
                    const index = mainUseCount.get(m.name) || 0;
                    const source = pluginMainMessages.filter(x => x.name === m.name)[index];
                    mainUseCount.set(m.name, index + 1);
                    if (source) {
                        m.icon = source.icon || '';
                        m.color = source.color || m.color;
                    } else {
                        m.icon = '';
                    }
                } else if (setting && !setting.portrait) {
                    m.icon = '';
                } else {
                    m.icon = journalImages[journalKey] || journalLinks[journalKey] || setting?.customUrl || whisperPortraits[m.channel] || (pluginPortraits.get(m.name) || []).at(-1) || '';
                }
            });
        }

        async function loadTwoHTML() {
            const plugin = pluginHtmlInput.files[0], exported = exportHtmlInput.files[0];
            if (!plugin || !exported) {
                previewArea.innerHTML = '<p style="color:#fbb034;padding:20px;">두 HTML 파일을 모두 선택하세요.</p>';
                return;
            }
            const progress = document.getElementById('progressOverlay');
            const progressText = document.getElementById('progressText');
            progress.classList.add('show'); progressText.textContent = 'HTML 분석 중...';
            try {
                pluginJournalColors = new Map();
                pluginPortraits = getPluginPortraits(await readLocalHTML(plugin));
                window.allMessages = parseWholeExport(await readLocalHTML(exported));
                if (!window.allMessages.length) throw new Error('전체 내보내기 HTML에서 메시지를 찾지 못했습니다.');
                window.selectedChannels = new Set(); whisperPortraits = {};
                initTabSettings(); renderChannelFilter(); createChannelColorSettings();
                if (bubbleThemeEnabled) applyBubbleDefaultColors();
                applyImportedPortraits();
                progressText.textContent = '로그 화면 생성 중...';
                await new Promise(requestAnimationFrame);
                renderMessages();
                progress.classList.remove('show');
            } catch (err) {
                progress.classList.remove('show');
                previewArea.innerHTML = `<p style="color:red;padding:20px;">파싱 오류: ${err.message}</p>`;
            }
        }

        pluginHtmlInput.addEventListener('change', loadTwoHTML);
        exportHtmlInput.addEventListener('change', loadTwoHTML);

        // 출력 탭 설정 상태와 저널별 이미지 override
        let tabSettings = new Map();
        let journalImages = {};
        let journalLinks = {};
        let activeOutputTab = '';

        function initTabSettings() {
            tabSettings = new Map([...new Set(window.allMessages.map(m => m.channel))].map(channel => [channel, {
                enabled: /main|메인/i.test(channel),
                badge: false,
                portrait: !/info|정보|other/i.test(channel),
                compact: false,
                customUrl: ''
            }]));
        }

        function renderChannelFilter() {
            // 출력 탭은 팝업에서만 관리한다.
        }

        function syncStyleChannelVisibility() {
            document.querySelectorAll('#channelColorSettings label[data-channel]').forEach(label => {
                label.style.display = tabSettings.get(label.dataset.channel)?.enabled === false ? 'none' : '';
            });
        }

        function applyPreviewTabVisibility() {
            previewArea.querySelectorAll('[data-channel]').forEach(node => {
                node.style.display = tabSettings.get(node.dataset.channel)?.enabled === false ? 'none' : '';
            });
        }

        async function regeneratePreview(message = '로그 화면을 다시 생성 중...') {
            const overlay = document.getElementById('progressOverlay');
            document.getElementById('progressText').textContent = message;
            overlay.classList.add('show');
            await new Promise(requestAnimationFrame);
            await new Promise(requestAnimationFrame);
            try { renderMessages(); } finally { overlay.classList.remove('show'); }
        }

        function renderTabDetail(channel) {
            activeOutputTab = channel;
            const detail = document.getElementById('outputTabDetail');
            detail.innerHTML = '';
            const setting = tabSettings.get(channel);
            const heading = document.createElement('b'); heading.textContent = `[${channel}] 이미지 설정`;
            detail.appendChild(heading);
            if (true) {
                const link = document.createElement('input');
                link.className = 'link-input'; link.placeholder = '이 탭 전체에 사용할 이미지 링크 (선택)'; link.value = setting.customUrl;
                link.onchange = () => { setting.customUrl = link.value.trim(); applyImportedPortraits(); renderMessages(); };
                detail.appendChild(link);
                const names = [...new Set(window.allMessages.filter(m => m.channel === channel).map(m => m.name).filter(Boolean))];
                names.forEach(name => {
                    const candidates = pluginPortraits.get(name) || [];
                    if (!candidates.length) return;
                    const row = document.createElement('div'); row.className = 'journal-row';
                    const label = document.createElement('span'); label.className = 'journal-name'; label.textContent = name; row.appendChild(label);
                    candidates.forEach(url => {
                        const button = document.createElement('button'); button.type = 'button'; button.className = 'portrait-option';
                        if (journalImages[`${channel}|${name}`] === url) button.classList.add('active');
                        const img = document.createElement('img'); img.src = url; img.alt = name; button.appendChild(img);
                        button.onclick = () => { journalImages[`${channel}|${name}`] = url; applyImportedPortraits(); renderTabDetail(channel); renderMessages(); };
                        row.appendChild(button);
                    });
                    detail.appendChild(row);
                });
            } else {
                const note = document.createElement('span'); note.style.cssText = 'display:block;color:#6b7280;font-size:12px;margin-top:8px'; note.textContent = '이 탭은 저널명과 내용만 출력하며 이미지·서술자 설정을 사용하지 않습니다.'; detail.appendChild(note);
            }
        }

        function renderOutputTabSettings() {
            const list = document.getElementById('outputTabList'); list.innerHTML = '';
            for (const [channel, setting] of tabSettings) {
                const row = document.createElement('div'); row.className = 'modal-tab-row';
                const open = document.createElement('button'); open.type = 'button'; open.className = 'tab-setting-btn' + (setting.enabled ? '' : ' tab-disabled'); open.textContent = channel; open.onclick = () => openJournalImageModal(channel);
                const output = document.createElement('label'); output.className = 'output-switch'; output.title = '출력 여부'; const outputCheck = document.createElement('input'); outputCheck.type = 'checkbox'; outputCheck.checked = setting.enabled; const slider = document.createElement('span'); slider.className = 'output-slider'; output.append(outputCheck, slider);
                const badge = document.createElement('button'); badge.type = 'button'; badge.className = 'tab-toggle' + (setting.badge ? ' active' : ''); badge.textContent = '뱃지'; badge.onclick = () => { setting.badge = !setting.badge; badge.classList.toggle('active', setting.badge); renderMessages(); };
                const portrait = document.createElement('button'); portrait.type = 'button'; portrait.className = 'tab-toggle' + (setting.portrait ? ' active' : ''); portrait.textContent = '포트레'; portrait.onclick = () => { setting.portrait = !setting.portrait; portrait.classList.toggle('active', setting.portrait); applyImportedPortraits(); renderMessages(); };
                let compact;
                if (/other/i.test(channel)) {
                    compact = document.createElement('button'); compact.type = 'button'; compact.className = 'tab-toggle' + (setting.compact ? ' active' : ''); compact.textContent = '간략화'; compact.onclick = () => { setting.compact = !setting.compact; compact.classList.toggle('active', setting.compact); syncDisabled(); renderMessages(); };
                }
                const syncDisabled = () => {
                    [badge, portrait].forEach(button => { button.classList.toggle('tab-option-disabled', !setting.enabled || setting.compact); button.disabled = !setting.enabled || setting.compact; });
                    if (compact) { compact.classList.toggle('tab-option-disabled', !setting.enabled); compact.disabled = !setting.enabled; }
                };
                outputCheck.onchange = () => { setting.enabled = outputCheck.checked; open.classList.toggle('tab-disabled', !setting.enabled); syncDisabled(); syncStyleChannelVisibility(); setTimeout(() => regeneratePreview('출력 탭을 다시 생성 중...'), 0); };
                row.append(output, open, badge, portrait, ...(compact ? [compact] : []));
                syncDisabled();
                list.appendChild(row);
            }
            document.getElementById('outputTabDetail').innerHTML = '<span style="color:#6b7280;font-size:12px;">스위치로 출력 여부를 바꾸고, 탭 제목을 누르면 저널별 이미지 설정이 열립니다.</span>';
        }

        function openJournalImageModal(channel) {
            activeOutputTab = channel;
            const list = document.getElementById('journalImageList');
            list.innerHTML = '';
            document.getElementById('journalImageModalNote').textContent = `[${channel}] 탭에서 발화한 저널별 이미지입니다. 정사각형 썸네일을 눌러 선택하세요.`;
            if (/main|메인/i.test(channel)) {
                list.innerHTML = '<p class="image-fallback">main 포트레이트는 플러그인 HTML의 변경 이력을 그대로 사용하므로 여기서 변경할 수 없습니다.</p>';
                document.getElementById('journalImageModal').classList.remove('hidden');
                return;
            }
            {
                const names = [...new Set(window.allMessages.filter(m => m.channel === channel).map(m => m.name).filter(Boolean))];
                names.forEach(name => {
                    const key = `${channel}|${name}`, candidates = pluginPortraits.get(name) || [];
                    const block = document.createElement('section'); block.className = 'image-journal-block';
                    const title = document.createElement('div'); title.className = 'image-journal-title'; title.textContent = name; block.appendChild(title);
                    const grid = document.createElement('div'); grid.className = 'image-choice-grid';
                    const currentImage = journalImages[key] || journalLinks[key] || tabSettings.get(channel)?.customUrl || candidates.at(-1) || '';
                    candidates.forEach(url => {
                        const button = document.createElement('button'); button.type = 'button'; button.className = 'image-choice' + (currentImage === url ? ' active' : '');
                        const image = document.createElement('img'); image.src = url; image.alt = name + ' 포트레이트'; button.appendChild(image);
                        button.onclick = () => { journalImages[key] = url; delete journalLinks[key]; applyImportedPortraits(); openJournalImageModal(channel); renderMessages(); };
                        grid.appendChild(button);
                    });
                    if (candidates.length) block.appendChild(grid);
                    const link = document.createElement('input'); link.className = 'link-input'; link.placeholder = '이미지 링크로 대체 (선택)'; link.value = journalLinks[key] || tabSettings.get(channel)?.customUrl || '';
                    link.onchange = () => { journalLinks[key] = link.value.trim(); delete journalImages[key]; applyImportedPortraits(); renderMessages(); };
                    block.appendChild(link);
                    if (!candidates.length) { const note = document.createElement('div'); note.className = 'image-fallback'; note.textContent = 'main에서 같은 이름의 저널 이미지를 찾지 못했습니다. 링크를 입력하세요.'; block.appendChild(note); }
                    list.appendChild(block);
                });
                if (!list.children.length) list.innerHTML = '<p class="image-fallback">이 탭에서 저널을 찾지 못했습니다.</p>';
            }
            document.getElementById('journalImageModal').classList.remove('hidden');
        }

        document.getElementById('outputTabSettingsBtn').onclick = () => { renderOutputTabSettings(); document.getElementById('outputTabModal').classList.remove('hidden'); };
        document.getElementById('outputTabModalClose').onclick = () => document.getElementById('outputTabModal').classList.add('hidden');
        document.getElementById('outputTabModal').addEventListener('click', e => { if (e.target.id === 'outputTabModal') e.target.classList.add('hidden'); });
        document.getElementById('journalImageModalClose').onclick = () => document.getElementById('journalImageModal').classList.add('hidden');
        document.getElementById('journalImageModal').addEventListener('click', e => { if (e.target.id === 'journalImageModal') e.target.classList.add('hidden'); });
    </script>
</body>

</html>
